import json
import time
from datetime import datetime
from pathlib import Path

import cv2
import numpy as np

from constants import (
    CAPTURE_DELAY_SECONDS,
    CAMERA_ID,
    COLOR_RANGES,
    COLOR_SAMPLE_RADIUS,
    ADAPTIVE_BLOCK_SIZE,
    ADAPTIVE_C,
    EXIT_COMMANDS,
    FRAME_HEIGHT,
    FRAME_WIDTH,
    FPS,
    GRID_COMMAND,
    GRID_MIN_INTERSECTIONS,
    HOUGH_MAX_LINE_GAP,
    HOUGH_MIN_LINE_LENGTH,
    HOUGH_THRESHOLD,
    LINE_CLUSTER_TOLERANCE,
    INTERSECTION_ROUNDING,
    COLOR_CLUSTER_TOLERANCE,
    COLOR_REGION_MIN_AREA,
    COLOR_COMPONENT_MIN_AREA,
    COLOR_COMPONENT_MAX_AREA,
    PALETTE_CLUSTER_COUNT,
    PALETTE_BACKGROUND_MAX_RATIO,
    PALETTE_BACKGROUND_MIN_COUNT,
    PALETTE_MIN_SATURATION,
    PALETTE_MIN_VALUE,
    PALETTE_SAMPLE_SIZE,
    MORPH_KERNEL_SIZE,
    OUTPUT_DIR,
    PROMPT_TEXT,
    GRID_AXIS_TOLERANCE,
    MIN_GRID_ROWS,
    MIN_GRID_COLS,
    MIN_GRID_COMPONENTS,
    REGION_THRESHOLD_MULTIPLIER,
    SAVE_LIMIT_SECONDS,
    WINDOW_NAME,
    WINDOW_DISPLAY_MS,
    WINDOW_WAIT_MS,
)


class GridDetector:
    def __init__(self, camera_id=CAMERA_ID):
        self.cap = cv2.VideoCapture(camera_id)
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, FRAME_WIDTH)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, FRAME_HEIGHT)
        self.cap.set(cv2.CAP_PROP_FPS, FPS)
        self.output_dir = Path(OUTPUT_DIR)
        self.output_dir.mkdir(parents=True, exist_ok=True)
        self.last_save_time = 0.0

        self.color_ranges = {
            name: (np.array(lower), np.array(upper))
            for name, (lower, upper) in COLOR_RANGES.items()
        }

    def detect_grid_lines(self, frame):
        """Detecta regiones de color que forman la cuadrícula."""
        regions, palette = self.detect_color_regions(frame)
        return regions, palette

    def preprocess_grid_image(self, frame):
        """Resalta líneas de cuadrícula y reduce ruido del fondo."""
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        blurred = cv2.GaussianBlur(gray, (5, 5), 0)
        clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8)).apply(blurred)
        binary = cv2.adaptiveThreshold(
            clahe,
            255,
            cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
            cv2.THRESH_BINARY_INV,
            ADAPTIVE_BLOCK_SIZE,
            ADAPTIVE_C,
        )

        kernel_horizontal = cv2.getStructuringElement(cv2.MORPH_RECT, (MORPH_KERNEL_SIZE, 1))
        kernel_vertical = cv2.getStructuringElement(cv2.MORPH_RECT, (1, MORPH_KERNEL_SIZE))
        horizontal = cv2.morphologyEx(binary, cv2.MORPH_OPEN, kernel_horizontal)
        vertical = cv2.morphologyEx(binary, cv2.MORPH_OPEN, kernel_vertical)

        combined = cv2.bitwise_or(horizontal, vertical)
        combined = cv2.morphologyEx(combined, cv2.MORPH_CLOSE, cv2.getStructuringElement(cv2.MORPH_RECT, (3, 3)))
        return combined

    def detect_color_regions(self, frame):
        """Extrae regiones usando la paleta dominante de la imagen."""
        palette = self._build_palette(frame)
        lab = cv2.cvtColor(frame, cv2.COLOR_BGR2LAB)
        height, width = lab.shape[:2]
        pixels = lab.reshape(-1, 3).astype(np.float32)

        if not palette:
            return [], []

        centers = np.float32([cluster["center_lab"] for cluster in palette])
        if len(centers) == 0:
            return [], []

        pixel_matrix = pixels[:, None, :]
        center_matrix = centers[None, :, :]
        distances = np.sum((pixel_matrix - center_matrix) ** 2, axis=2)
        labels = np.argmin(distances, axis=1).reshape(height, width).astype(np.uint8)

        regions = []
        for cluster_index, cluster in enumerate(palette):
            mask = (labels == cluster_index).astype(np.uint8) * 255
            coverage = cv2.countNonZero(mask) / float(mask.size)
            if coverage > PALETTE_BACKGROUND_MAX_RATIO:
                continue
            if cv2.countNonZero(mask) < PALETTE_BACKGROUND_MIN_COUNT:
                continue

            # Morphological filtering más agresivo para eliminar ruido
            mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5, 5), np.uint8))
            mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, np.ones((7, 7), np.uint8))

            contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            for contour in contours:
                area = cv2.contourArea(contour)
                if area < COLOR_COMPONENT_MIN_AREA or area > COLOR_COMPONENT_MAX_AREA:
                    continue

                x, y, w, h = cv2.boundingRect(contour)
                # Filtro más estricto para evitar rectángulos muy alargados o pequeños
                if w < 8 or h < 8:
                    continue
                aspect_ratio = float(w) / float(h) if h > 0 else 0
                if aspect_ratio > 3.0 or aspect_ratio < 0.33:
                    continue

                center_x = x + w // 2
                center_y = y + h // 2
                regions.append(
                    {
                        "cluster_id": cluster_index,
                        "color": cluster["name"],
                        "center": (center_x, center_y),
                        "area": float(area),
                        "bbox": (x, y, x + w, y + h),
                        "center_lab": cluster["center_lab"],
                    }
                )

        regions.sort(key=lambda region: (region["center"][1], region["center"][0]))
        return regions, palette

    def _build_palette(self, frame):
        """Construye una paleta dominante desde la imagen."""
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        lab = cv2.cvtColor(frame, cv2.COLOR_BGR2LAB)
        pixels = lab.reshape(-1, 3)

        if len(pixels) > PALETTE_SAMPLE_SIZE:
            indices = np.linspace(0, len(pixels) - 1, PALETTE_SAMPLE_SIZE, dtype=int)
            pixels = pixels[indices]

        hsv_pixels = hsv.reshape(-1, 3)
        if len(hsv_pixels) > PALETTE_SAMPLE_SIZE:
            hsv_pixels = hsv_pixels[indices]

        mask = (hsv_pixels[:, 1] >= PALETTE_MIN_SATURATION) & (hsv_pixels[:, 2] >= PALETTE_MIN_VALUE)
        colorful_pixels = pixels[mask]
        if len(colorful_pixels) < 100:
            colorful_pixels = pixels

        data = np.float32(colorful_pixels)
        cluster_count = min(PALETTE_CLUSTER_COUNT, len(data))
        if cluster_count <= 0:
            return []

        _compactness, labels, centers = cv2.kmeans(
            data,
            cluster_count,
            None,
            (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 20, 1.0),
            5,
            cv2.KMEANS_PP_CENTERS,
        )

        centers = np.uint8(centers)
        palette = []
        for index, center in enumerate(centers):
            l_val, a_val, b_val = center.tolist()
            palette.append(
                {
                    "name": f"cluster_{index}",
                    "center_lab": (int(l_val), int(a_val), int(b_val)),
                }
            )

        return palette

    def build_artificial_grid(self, regions):
        """Agrupa regiones por filas/columnas y genera la rejilla artificial."""
        if not regions:
            return []

        x_centers = [region["center"][0] for region in regions]
        y_centers = [region["center"][1] for region in regions]
        axis_count = self._estimate_axis_count(len(regions))

        columns = self._cluster_positions(x_centers, axis_count)
        rows = self._cluster_positions(y_centers, axis_count)

        if len(rows) < MIN_GRID_ROWS or len(columns) < MIN_GRID_COLS:
            return []

        cells = []
        for region in regions:
            center_x, center_y = region["center"]
            row_index = self._nearest_index(rows, center_y)
            col_index = self._nearest_index(columns, center_x)
            x1, y1, x2, y2 = region["bbox"]
            cells.append(
                {
                    "row": row_index,
                    "col": col_index,
                    "position": [col_index, row_index],
                    "x1": int(x1),
                    "y1": int(y1),
                    "x2": int(x2),
                    "y2": int(y2),
                    "center": [int(center_x), int(center_y)],
                    "area": float(region["area"]),
                    "color": region["color"],
                    "cluster_id": region["cluster_id"],
                }
            )

        grid_matrix = [[None for _ in columns] for _ in rows]
        for cell in cells:
            if 0 <= cell["row"] < len(rows) and 0 <= cell["col"] < len(columns):
                grid_matrix[cell["row"]][cell["col"]] = cell

        self._grid_layout = {
            "rows": rows,
            "columns": columns,
            "cells": cells,
            "matrix": grid_matrix,
        }

        return cells

    def _estimate_axis_count(self, region_count):
        """Estima cuántas filas/columnas tiene la cuadrícula."""
        return min(4, max(2, int(round(np.sqrt(region_count)))))

    def _cluster_positions(self, positions, cluster_count):
        """Agrupa posiciones con k-means 1D para obtener bandas de la rejilla."""
        if not positions:
            return []

        if len(positions) <= cluster_count:
            return sorted(int(value) for value in positions)

        data = np.float32(positions).reshape(-1, 1)
        compactness, labels, centers = cv2.kmeans(
            data,
            cluster_count,
            None,
            (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 20, 0.1),
            10,
            cv2.KMEANS_PP_CENTERS,
        )
        del compactness, labels
        return sorted(int(round(center[0])) for center in centers)

    def detect_mosaic_colors(self, frame, intersections):
        """Devuelve las celdas coloreadas detectadas como grid."""
        if not intersections or not hasattr(self, "_grid_layout"):
            return []

        cells = self._grid_layout.get("cells", [])
        cells.sort(key=lambda cell: (cell["row"], cell["col"]))
        return cells

    def _nearest_index(self, values, target):
        if not values:
            return 0
        return min(range(len(values)), key=lambda idx: abs(values[idx] - target))

    def get_dominant_color(self, hsv_frame, x, y, radius=COLOR_SAMPLE_RADIUS):
        """Obtiene el color dominante en una región."""
        x1 = max(0, x - radius)
        x2 = min(hsv_frame.shape[1], x + radius)
        y1 = max(0, y - radius)
        y2 = min(hsv_frame.shape[0], y + radius)

        region = hsv_frame[y1:y2, x1:x2]

        for color_name, (lower, upper) in self.color_ranges.items():
            mask = cv2.inRange(region, lower, upper)
            if np.sum(mask) > (radius * radius * 2) * REGION_THRESHOLD_MULTIPLIER:
                return color_name

        return "unknown"

    def process_frame(self):
        """Procesa un frame completo."""
        ret, frame = self.cap.read()
        if not ret:
            return None, None

        regions, palette = self.detect_grid_lines(frame)
        cells = self.build_artificial_grid(regions)
        colors = self.detect_mosaic_colors(frame, cells)

        result = {
            "timestamp": time.time(),
            "palette": palette,
            "intersections": [cell["center"] for cell in colors],
            "colors": colors,
            "frame_shape": frame.shape,
            "grid_detected": len(colors) >= MIN_GRID_COMPONENTS,
            "grid": self._grid_layout if hasattr(self, "_grid_layout") else {},
        }
        return frame, result

    def process_image(self, image_path):
        """Procesa una imagen estática desde disco."""
        path = Path(image_path).expanduser()
        if not path.is_file():
            return None, None, f"No existe la imagen: {path}"

        frame = cv2.imread(str(path))
        if frame is None:
            return None, None, f"No se pudo leer la imagen: {path}"

        regions, palette = self.detect_grid_lines(frame)
        cells = self.build_artificial_grid(regions)
        colors = self.detect_mosaic_colors(frame, cells)

        result = {
            "timestamp": time.time(),
            "source_image": str(path),
            "palette": palette,
            "intersections": [cell["center"] for cell in colors],
            "colors": colors,
            "frame_shape": frame.shape,
            "grid_detected": len(colors) >= MIN_GRID_COMPONENTS,
            "grid": self._grid_layout if hasattr(self, "_grid_layout") else {},
        }
        return frame, result, None

    def save_grid_capture(self, frame, result):
        """Guarda la imagen y los datos detectados."""
        now = time.time()
        if now - self.last_save_time < SAVE_LIMIT_SECONDS:
            return None

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        image_path = self.output_dir / f"grid_{timestamp}.jpg"
        data_path = self.output_dir / f"grid_{timestamp}.json"

        cv2.imwrite(str(image_path), frame)

        serializable_result = dict(result)
        serializable_result["intersections"] = [list(point) for point in result["intersections"]]
        serializable_result["palette"] = list(result.get("palette", []))
        serializable_result["colors"] = [
            {
                **cell,
                "position": list(cell["position"]),
                "center": list(cell["center"]),
            }
            for cell in result["colors"]
        ]
        if "grid" in result:
            serializable_result["grid"] = result["grid"]
        serializable_result["saved_image"] = str(image_path)

        with open(data_path, "w", encoding="utf-8") as file:
            json.dump(serializable_result, file, ensure_ascii=False, indent=2)

        self.last_save_time = now
        return {"image": str(image_path), "data": str(data_path)}

    def draw_detection(self, frame, result):
        """Dibuja las celdas de color detectadas sobre la imagen."""
        output = frame.copy()

        for cell in result["colors"]:
            x1, y1, x2, y2 = cell["x1"], cell["y1"], cell["x2"], cell["y2"]
            x, y = cell["center"]
            cv2.rectangle(output, (x1, y1), (x2, y2), (0, 255, 0), 2)
            cv2.circle(output, (x, y), 5, (0, 255, 255), -1)
            cv2.putText(
                output,
                cell["color"],
                (x1, max(10, y1 - 5)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.4,
                (255, 255, 255),
                1,
                cv2.LINE_AA,
            )

        cv2.putText(
            output,
            f"Cells: {len(result['colors'])}",
            (10, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            1.0,
            (0, 255, 0),
            2,
            cv2.LINE_AA,
        )

        return output

    def show_detected_grid(self, frame, result):
        """Muestra la imagen detectada en una ventana."""
        display_frame = self.draw_detection(frame, result)
        cv2.imshow(WINDOW_NAME, display_frame)
        cv2.waitKey(WINDOW_DISPLAY_MS)

    def parse_grid_command(self, command_text):
        """Extrae la ruta opcional de `get grid`."""
        normalized = command_text.strip()
        if not normalized.lower().startswith(GRID_COMMAND):
            return None

        remainder = normalized[len(GRID_COMMAND):].strip()
        return remainder or None

    def capture_until_grid(self, timeout_seconds=5.0):
        """Intenta detectar la cuadrícula durante unos segundos."""
        start_time = time.time()
        latest_frame = None
        latest_result = None

        while time.time() - start_time < timeout_seconds:
            frame, result = self.process_frame()
            if frame is not None:
                latest_frame = frame
                latest_result = result

            if result and result["grid_detected"]:
                return frame, result

            time.sleep(CAPTURE_DELAY_SECONDS)

        return latest_frame, latest_result

    def release(self):
        self.cap.release()


def run_terminal_mode():
    detector = GridDetector()

    print(PROMPT_TEXT)
    print(f'Escribe "{GRID_COMMAND}" para capturar desde cámara.')
    print(f'Escribe "{GRID_COMMAND} <ruta_imagen>" para procesar una imagen.')
    print(f'Escribe uno de {sorted(EXIT_COMMANDS)} para salir.')

    try:
        while True:
            command = input("> ").strip()

            if command.lower() in EXIT_COMMANDS:
                break

            image_path = detector.parse_grid_command(command)
            if image_path is None and command.strip().lower() != GRID_COMMAND:
                print(f'Comando desconocido. Usa "{GRID_COMMAND}" o "quit".')
                continue

            if image_path:
                frame, result, error = detector.process_image(image_path)
                if error:
                    print(error)
                    continue
            else:
                frame, result = detector.capture_until_grid()
                if frame is None or result is None:
                    print("No se pudo leer la cámara.")
                    continue

            if result["grid_detected"]:
                saved = detector.save_grid_capture(frame, result)
                detector.show_detected_grid(frame, result)
                if saved:
                    print(f'Cuadrícula guardada en {saved["image"]}')
                    print(f'Datos guardados en {saved["data"]}')
                print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
            else:
                print("No se detectó la cuadrícula en el tiempo límite.")
                print(json.dumps(result, ensure_ascii=False, indent=2, default=str))
    finally:
        detector.release()
        cv2.destroyAllWindows()


if __name__ == "__main__":
    run_terminal_mode()